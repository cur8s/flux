#!/usr/bin/env bash
set -euo pipefail
REPO_ROOT="$(git rev-parse --show-toplevel)"
source "$REPO_ROOT/scripts/lib/display.sh"

KUBE_VERSION="${KUBE_VERSION:-1.33.0}"
MANIFEST="$REPO_ROOT/oci/flux/deploy/flux.yaml"

banner "Validating rendered manifests (k8s $KUBE_VERSION)"
[ -f "$MANIFEST" ] || { error "not rendered: $MANIFEST (run make render)"; exit 1; }

kubeconform \
  -strict \
  -ignore-missing-schemas \
  -kubernetes-version "$KUBE_VERSION" \
  -summary \
  "$MANIFEST"

success "kubeconform passed"
