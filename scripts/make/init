#!/usr/bin/env bash
set -euo pipefail
# Bootstrap Flux into a cluster: kubectl apply of the rendered install manifest.
# Server-side apply handles the large CRDs cleanly.
REPO_ROOT="$(git rev-parse --show-toplevel)"
source "$REPO_ROOT/scripts/lib/display.sh"

CLUSTER_NAME="${1:?cluster name required}"
CTX="k3d-$CLUSTER_NAME"
MANIFEST="$REPO_ROOT/oci/flux/deploy/flux.yaml"

[ -f "$MANIFEST" ] || { error "not built: $MANIFEST (run make build)"; exit 1; }
"$REPO_ROOT/scripts/cluster" exists "$CLUSTER_NAME" 2>/dev/null || { error "cluster '$CLUSTER_NAME' missing (run make cluster)"; exit 1; }

banner "Installing Flux controllers"
kubectl --context "$CTX" apply --server-side -f "$MANIFEST"

echo "⏳ waiting for controllers to be Available..."
kubectl --context "$CTX" -n flux-system wait deploy --for=condition=Available --timeout=3m --all
success "Flux controllers ready (idle — run make sync to start self-management)"
