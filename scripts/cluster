#!/usr/bin/env bash
set -euo pipefail
# ─────────────────────────────────────────────────────────────────────────────
# k3d cluster lifecycle (create/delete/exists/env/status/reset).
#
# Each cluster gets its own local OCI registry (<name>-registry). No host ports
# are mapped — Flux needs no ingress — so multiple clusters coexist without
# port conflicts.
# ─────────────────────────────────────────────────────────────────────────────

REPO_ROOT="$(git rev-parse --show-toplevel)"
source "$REPO_ROOT/scripts/lib/display.sh"

check_dependencies() {
  local missing=()
  for tool in k3d kubectl jq docker; do
    command -v "$tool" &>/dev/null || missing+=("$tool")
  done
  if [ ${#missing[@]} -gt 0 ]; then
    error "missing required tools: ${missing[*]}"; exit 1
  fi
}

get_registry_port() {
  # k3d may name the registry container "<name>" or "k3d-<name>"; try both.
  local port
  for c in "$1" "k3d-$1"; do
    port=$(docker inspect "$c" 2>/dev/null | \
      jq -r '.[0].NetworkSettings.Ports["5000/tcp"][0].HostPort // empty')
    [ -n "$port" ] && { echo "$port"; return; }
  done
  echo "unknown"
}
get_api_port() {
  docker inspect "k3d-$1-serverlb" 2>/dev/null | \
    jq -r '.[0].NetworkSettings.Ports["6443/tcp"][0].HostPort // "unknown"'
}

cluster_exists() {
  k3d cluster list -o json 2>/dev/null | jq -e ".[] | select(.name == \"$1\")" >/dev/null 2>&1
}

get_cluster_state() {
  cluster_exists "$1" || { echo "missing"; return; }
  local running
  running=$(docker ps --filter "label=k3d.cluster=$1" --format '{{.ID}}' | wc -l | tr -d ' ')
  [ "$running" -gt 0 ] && echo "running" || echo "stopped"
}

cmd_create() {
  local name="$1"
  check_dependencies

  if cluster_exists "$name"; then
    if [ ! -t 0 ]; then
      warn "cluster '$name' exists — non-interactive mode, recreating" >&2
      k3d cluster delete "$name" 2>/dev/null || true
      k3d registry delete "${name}-registry" 2>/dev/null || true
    else
      read -p "Cluster '$name' exists. Delete and recreate? [y/N]: " -n 1 -r; echo >&2
      [[ $REPLY =~ ^[Yy]$ ]] || { error "aborted"; exit 1; }
      k3d cluster delete "$name" 2>/dev/null || true
      k3d registry delete "${name}-registry" 2>/dev/null || true
    fi
  fi

  local registry="${name}-registry"
  banner "Creating cluster '$name' (+ registry $registry)" >&2
  k3d cluster create "$name" \
    --config "$REPO_ROOT/scripts/k3d-config.yaml" \
    --registry-create "$registry" >&2

  echo "⏳ waiting for API..." >&2
  local elapsed=0
  while [ $elapsed -lt 60 ]; do
    kubectl --context "k3d-$name" cluster-info &>/dev/null && break
    sleep 2; elapsed=$((elapsed + 2))
  done
  [ $elapsed -lt 60 ] || { error "cluster not ready in 60s"; exit 1; }

  echo "⏳ waiting for registry..." >&2
  local reg_port; elapsed=0
  while [ $elapsed -lt 60 ]; do
    reg_port=$(get_registry_port "$registry")
    if [ "$reg_port" != "unknown" ] && curl -sf "http://localhost:${reg_port}/v2/" >/dev/null 2>&1; then
      break
    fi
    sleep 2; elapsed=$((elapsed + 2))
  done
  [ $elapsed -lt 60 ] || { error "registry not ready in 60s"; exit 1; }

  banner "Cluster ready" >&2
  echo "Cluster:      $name"          >&2
  echo "Context:      k3d-$name"      >&2
  echo "Registry:     localhost:$reg_port  (in-cluster: $registry:5000)" >&2
  success "ready — next: make init" >&2
}

cmd_env() {
  local name="$1"; check_dependencies
  cluster_exists "$name" || { error "cluster '$name' does not exist"; exit 1; }
  echo "export CLUSTER_NAME=\"$name\""
  echo "export CLUSTER_REG_PORT=\"$(get_registry_port "${name}-registry")\""
  echo "export CLUSTER_API_PORT=\"$(get_api_port "$name")\""
}

cmd_status() {
  local name="$1"; check_dependencies
  local state; state=$(get_cluster_state "$name")
  echo "Cluster: $name"
  echo "State:   $state"
  echo "Context: k3d-$name"
  [ "$state" = "missing" ] && return
  echo "Registry: localhost:$(get_registry_port "${name}-registry")  (in-cluster: ${name}-registry:5000)"
}

cmd_delete() {
  local name="$1"; check_dependencies
  k3d cluster delete "$name" 2>/dev/null || true
  k3d registry delete "${name}-registry" 2>/dev/null || true
  success "cluster '$name' deleted"
}

cmd_reset() { cmd_delete "$1"; cmd_create "$1"; }
cmd_exists() { cluster_exists "$1"; }

usage() {
  cat <<EOF
Usage: cluster <command> <name>

  create <name>   Create a k3d cluster + local registry
  reset  <name>   Delete and recreate
  delete <name>   Delete cluster and registry
  exists <name>   Exit 0 if exists, 1 otherwise
  env    <name>   Print CLUSTER_* exports for an existing cluster
  status <name>   Show cluster status
EOF
  exit 0
}

[ $# -ge 1 ] || usage
COMMAND="$1"; shift
case "$COMMAND" in
  create) [ $# -ge 1 ] || { error "name required"; exit 1; }; cmd_create "$1" ;;
  reset)  [ $# -ge 1 ] || { error "name required"; exit 1; }; cmd_reset  "$1" ;;
  delete) [ $# -ge 1 ] || { error "name required"; exit 1; }; cmd_delete "$1" ;;
  exists) [ $# -ge 1 ] || { error "name required"; exit 1; }; cmd_exists "$1" ;;
  env)    [ $# -ge 1 ] || { error "name required"; exit 1; }; cmd_env    "$1" ;;
  status) [ $# -ge 1 ] || { error "name required"; exit 1; }; cmd_status "$1" ;;
  -h|--help|help) usage ;;
  *) error "unknown command '$COMMAND'"; usage ;;
esac
