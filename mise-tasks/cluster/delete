#!/usr/bin/env bash
#MISE description="Delete a k3d cluster and its registry (name arg optional)"
set -euo pipefail
REPO_ROOT="$MISE_CONFIG_ROOT"
source "$REPO_ROOT/scripts/lib/display.sh"
source "$REPO_ROOT/mise-tasks/cluster/k3d.sh"

NAME="${1:-$CLUSTER_NAME}"
require_docker
k3d cluster delete "$NAME" 2>/dev/null || true
k3d registry delete "${NAME}-registry" 2>/dev/null || true
success "cluster '$NAME' deleted"
