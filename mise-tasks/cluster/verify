#!/usr/bin/env bash
#MISE description="Verify the controllers + self-management Kustomization are Ready"
set -uo pipefail
# Verify what this repo owns: the three controllers and the self-management
# Kustomization. Exit code = number of failed checks (0 = all good).
REPO_ROOT="$MISE_CONFIG_ROOT"
source "$REPO_ROOT/mise-tasks/cluster/verify.sh"

verify_init "${1:-}"

section "Flux Controllers"
for d in source-controller kustomize-controller notification-controller; do
  check_deployment "$d" flux-system
done

section "Self-management"
check_ocirepository flux flux-system
check_kustomization flux flux-system

echo ""
if [ "$FAILED_COUNT" -eq 0 ]; then
  success "all checks passed"
else
  error "$FAILED_COUNT check(s) failed"
fi
exit "$FAILED_COUNT"
