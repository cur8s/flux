#!/usr/bin/env bash
#MISE description="Hand Flux its self-management config (OCIRepository + Kustomization)"
set -euo pipefail
# After this, bumping the artifact tag is how Flux upgrades itself.
REPO_ROOT="$MISE_CONFIG_ROOT"
source "$REPO_ROOT/scripts/lib/display.sh"
source "$REPO_ROOT/mise-tasks/cluster/k3d.sh"

NAME="${1:-$CLUSTER_NAME}"
TAG="${2:-dev}"
CTX="k3d-$NAME"
# In-cluster registry DNS (Flux reaches the registry by its docker-network name).
REG="${NAME}-registry:5000"

cluster_exists "$NAME" || { error "cluster '$NAME' missing (run 'mise run cluster:create')"; exit 1; }
kubectl --context "$CTX" get ns flux-system &>/dev/null || { error "Flux not installed (run 'mise run cluster:init')"; exit 1; }

banner "Applying GitOps configuration"
echo "📝 OCIRepository flux → oci://${REG}/flux:${TAG} (insecure, dev registry)"
kubectl --context "$CTX" apply -f - <<EOF
apiVersion: source.toolkit.fluxcd.io/v1
kind: OCIRepository
metadata:
  name: flux
  namespace: flux-system
spec:
  interval: 1m
  url: oci://${REG}/flux
  ref:
    tag: "${TAG}"
  insecure: true
EOF

kubectl --context "$CTX" apply -f "$REPO_ROOT/oci/flux/sync.yaml"
success "Flux now self-manages from the OCI artifact"
