#!/usr/bin/env bash
#MISE description="Validate Flux version construction and input rejection"
set -euo pipefail
REPO_ROOT="$MISE_CONFIG_ROOT"
source "$REPO_ROOT/scripts/lib/version.sh"

assert_facts() {
  local file="$1" expected_tag="$2" expected_version="$3"
  load_flux_version "$file"
  [ "$FLUX_TAG" = "$expected_tag" ]
  [ "$CUR8S_FLUX_VERSION" = "$expected_version" ]
}

tmpdir="$(mktemp -d)"
trap 'rm -rf "$tmpdir"' EXIT

assert_facts "$REPO_ROOT/version.env" "v2.9.0" "v2.9.0"
printf 'FLUX_VERSION=2.9.0\nCUR8S_FLUX_REVISION=2\n' > "$tmpdir/revision-2.env"
assert_facts "$tmpdir/revision-2.env" "v2.9.0" "v2.9.0-2"

for invalid in \
  'FLUX_VERSION=2.9\nCUR8S_FLUX_REVISION=1' \
  'FLUX_VERSION=2.9.0-rc.1\nCUR8S_FLUX_REVISION=1' \
  'FLUX_VERSION=2.9.0\nCUR8S_FLUX_REVISION=0' \
  'FLUX_VERSION=2.9.0\nCUR8S_FLUX_REVISION=two'; do
  printf '%b\n' "$invalid" > "$tmpdir/invalid.env"
  if (load_flux_version "$tmpdir/invalid.env") >/dev/null 2>&1; then
    echo "❌ invalid version input was accepted" >&2
    exit 1
  fi
done

echo "✅ version construction and validation passed"
