#!/usr/bin/env bash
#MISE description="Full ephemeral proof: build → cluster → push → bootstrap → self-manage → verify"
set -euo pipefail
# On success the cluster is deleted; on failure it is preserved for debugging.
REPO_ROOT="$MISE_CONFIG_ROOT"
source "$REPO_ROOT/scripts/lib/display.sh"

CLUSTER="${1:-flux-e2e}"
TAG="test"
CTX="k3d-$CLUSTER"

cleanup() {
  local rc=$?
  if [ $rc -eq 0 ]; then
    banner "✅ e2e passed — deleting cluster '$CLUSTER'"
    mise run cluster:delete "$CLUSTER" || true
  else
    banner "❌ e2e failed (rc=$rc) — cluster '$CLUSTER' preserved"
    echo "  kubectl --context $CTX get all -A"
    echo "  flux --context $CTX get all -A"
    echo "  kubectl --context $CTX -n flux-system logs deploy/kustomize-controller"
    echo "  mise run cluster:delete $CLUSTER   # when done"
  fi
}
trap cleanup EXIT

banner "E2E 1/6 — build"
mise run artifact:build

banner "E2E 2/6 — cluster"
mise run cluster:create "$CLUSTER"

banner "E2E 3/6 — push artifact"
mise run artifact:push k3d "$CLUSTER" "$TAG"

banner "E2E 4/6 — init (bootstrap Flux)"
mise run cluster:init "$CLUSTER"

banner "E2E 5/6 — sync (self-management)"
mise run cluster:sync "$CLUSTER" "$TAG"

banner "E2E — waiting for self-managed reconciliation"
elapsed=0; timeout=180
while [ $elapsed -lt $timeout ]; do
  src=$(kubectl --context "$CTX" -n flux-system get ocirepository flux \
        -o jsonpath='{.status.conditions[?(@.type=="Ready")].status}' 2>/dev/null || echo "")
  ks=$(kubectl --context "$CTX" -n flux-system get kustomization flux \
        -o jsonpath='{.status.conditions[?(@.type=="Ready")].status}' 2>/dev/null || echo "")
  printf "[%3ds] OCIRepository=%s Kustomization=%s\n" "$elapsed" "${src:-?}" "${ks:-?}"
  [ "$src" = "True" ] && [ "$ks" = "True" ] && { echo "✅ self-managed reconciliation Ready"; break; }
  sleep 5; elapsed=$((elapsed + 5))
done
if [ "${src:-}" != "True" ] || [ "${ks:-}" != "True" ]; then
  error "self-management did not become Ready in ${timeout}s"
  flux --context "$CTX" get all -A || true
  exit 1
fi

banner "E2E 6/6 — verify"
mise run cluster:verify "$CLUSTER"

banner "E2E — flux state"
flux --context "$CTX" get all -A || true
