#!/usr/bin/env bash
#MISE description="Prove the committed oci/ tree + FETCH.lock match a fresh build (the review-surface gate)"
set -euo pipefail
# The committed oci/ tree is the review surface: what is in git must be
# exactly what the pipeline produces from src/. A fresh build that
# leaves the working tree dirty means the render and the commit have
# diverged — re-render and commit the difference.
REPO_ROOT="$MISE_CONFIG_ROOT"
source "$REPO_ROOT/scripts/lib/display.sh"
cd "$REPO_ROOT"

mise run artifact:build

banner "Drift check — committed tree vs fresh build"
if [ -n "$(git status --porcelain -- oci src/flux/artifacts)" ]; then
  git status --short -- oci src/flux/artifacts
  git --no-pager diff -- oci src/flux/artifacts | head -100
  error "fresh build differs from the committed tree — review and commit the re-render"
  exit 1
fi
success "committed tree matches the build"
