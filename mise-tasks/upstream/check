#!/usr/bin/env bash
#MISE description="Report whether a newer upstream Flux release exists than the tracked version"
set -euo pipefail
REPO_ROOT="$MISE_CONFIG_ROOT"
source "$REPO_ROOT/scripts/lib/display.sh"

source "$REPO_ROOT/scripts/lib/version.sh"
load_flux_version "$REPO_ROOT/version.env"
LATEST="$(curl -fsSL https://api.github.com/repos/fluxcd/flux2/releases/latest | jq -r '.tag_name')"

echo "tracked: $FLUX_TAG"
echo "latest:  $LATEST"
if [ "$FLUX_TAG" = "$LATEST" ]; then
  success "up to date"
else
  warn "update available: $FLUX_TAG → $LATEST  (bump FLUX_VERSION in version.env, then 'mise run artifact:build' and 'mise run test:e2e')"
fi
