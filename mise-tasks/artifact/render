#!/usr/bin/env bash
#MISE description="Render the opinionated overlay into the artifact tree (oci/flux/)"
set -euo pipefail
REPO_ROOT="$MISE_CONFIG_ROOT"
source "$REPO_ROOT/mise-tasks/artifact/facts.sh"

echo "🔨 Rendering opinionated config → oci/flux/ ..."
mkdir -p "$REPO_ROOT/oci/flux/deploy"
kustomize build --load-restrictor=LoadRestrictionsNone \
  "$REPO_ROOT/src/flux/config/overlays/deploy" > "$REPO_ROOT/oci/flux/deploy/flux.yaml"
cp "$REPO_ROOT/src/flux/config/sync.yaml" "$REPO_ROOT/oci/flux/sync.yaml"

# The release descriptor: the artifact asserting its own identity
# (flagship RFC-013). Deliberately free of anything unknowable at
# render time (no git revision, no timestamp) so the committed tree
# regenerates byte-for-byte — source/revision are attached by
# artifact:push as standard OCI annotations instead.
component_facts
cat > "$REPO_ROOT/oci/flux/cur8s.yaml" <<EOF
# Cur8s release descriptor — the artifact asserts its own identity.
# Inert: read by humans and tooling, never applied to a cluster.
# Generated by 'mise run artifact:render'; do not edit.
schema: cur8s.io/release-descriptor/v1
component: ${CUR8S_COMPONENT}
version: ${CUR8S_FLUX_VERSION}
upstream:
  project: ${CUR8S_UPSTREAM_PROJECT}
  version: ${FLUX_TAG}
  digest: ${CUR8S_UPSTREAM_DIGEST}
source: ${CUR8S_SOURCE}
docs: ${CUR8S_DOCS}
EOF

echo "   ✅ oci/flux/deploy/flux.yaml"
echo "   ✅ oci/flux/sync.yaml"
echo "   ✅ oci/flux/cur8s.yaml"
