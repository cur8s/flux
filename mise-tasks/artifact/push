#!/usr/bin/env bash
#MISE description="Push oci/flux/ as an OCI artifact: [k3d [cluster] [tag] | oci <registry> <tag>] (default: dev cluster, tag dev)"
set -euo pipefail
# Every artifact that leaves this repo — dev push or release — goes
# through this task: the single insertion point for OCI metadata.
REPO_ROOT="$MISE_CONFIG_ROOT"
source "$REPO_ROOT/scripts/lib/display.sh"
source "$REPO_ROOT/mise-tasks/cluster/k3d.sh"

MODE="${1:-k3d}"
[ $# -gt 0 ] && shift
case "$MODE" in
  k3d)
    NAME="${1:-$CLUSTER_NAME}"; TAG="${2:-dev}"
    cluster_exists "$NAME" || { error "cluster '$NAME' missing (run 'mise run cluster:create')"; exit 1; }
    REG_PORT="$(get_registry_port "${NAME}-registry")"
    [ "$REG_PORT" != "unknown" ] || { error "registry for cluster '$NAME' not found"; exit 1; }
    REGISTRY_URL="localhost:${REG_PORT}"
    # The k3d-local registry is anonymous. A globally-configured docker
    # credential helper (e.g. Docker Desktop's "desktop" credsStore) will be
    # invoked for it anyway and can hang indefinitely on a localhost registry.
    # Point this push at a throwaway docker config with no credsStore so the
    # OCI client uses anonymous auth.
    DOCKER_CONFIG="$(mktemp -d)"; export DOCKER_CONFIG
    echo '{"auths":{}}' > "$DOCKER_CONFIG/config.json"
    trap 'rm -rf "$DOCKER_CONFIG"' EXIT
    ;;
  oci)
    REGISTRY_URL="${1:?registry required}"; TAG="${2:?tag required}"
    ;;
  *) error "unknown mode '$MODE' (use k3d|oci)"; exit 1 ;;
esac

ARTIFACT_PATH="$REPO_ROOT/oci/flux"
[ -d "$ARTIFACT_PATH" ] || { error "artifact dir not found: $ARTIFACT_PATH (run 'mise run artifact:build')"; exit 1; }

OCI_URL="oci://${REGISTRY_URL}/flux:${TAG}"
banner "Pushing flux artifact"
echo "📦 $OCI_URL"
flux push artifact "$OCI_URL" \
  --path="$ARTIFACT_PATH" \
  --source="$(git config --get remote.origin.url 2>/dev/null || echo 'unknown')" \
  --revision="$(git branch --show-current 2>/dev/null || echo 'main')@sha1:$(git rev-parse HEAD 2>/dev/null || echo '0000000')" \
  --timeout=5m

success "pushed $OCI_URL"
