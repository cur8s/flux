#!/usr/bin/env bash
#MISE description="Build and publish the versioned artifact to the production registry"
set -euo pipefail
# Publication is gated on a green test:e2e for this VERSION (flagship
# RFC-011) and happens only on an explicit ask (AGENTS.md).
FLUX_VERSION="$(cat "$MISE_CONFIG_ROOT/VERSION")"
mise run artifact:build
mise run artifact:push oci "$REGISTRY" "$FLUX_VERSION"
