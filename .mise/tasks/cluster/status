#!/usr/bin/env bash
#MISE description="Show whether a k3d cluster exists, its API is reachable, and its registry endpoint"
#USAGE arg "[name]" env="CLUSTER_NAME" help="Cluster name (must start with <component>-)"
set -euo pipefail
# Exits non-zero only when the cluster does not exist (or k3d cannot list
# clusters); an existing but stopped or unhealthy cluster is reported, not failed.
name="$usage_name"
[[ "$name" == "$CUR8S_COMPONENT"-* ]] || { echo "❌ cluster name must start with $CUR8S_COMPONENT-" >&2; exit 1; }
clusters="$(k3d cluster list --no-headers)"
awk -v n="$name" '$1 == n { found = 1 } END { exit !found }' <<<"$clusters" \
  || { echo "❌ cluster $name does not exist" >&2; exit 1; }
k3d cluster list "$name"
if kubectl --context "k3d-$name" get --raw /readyz --request-timeout=5s >/dev/null 2>&1; then
  echo "api: reachable"
else
  echo "api: unreachable"
fi
port="$(docker port "$name-registry" 5000 2>/dev/null | head -1 | awk -F: '{print $NF}')" || true
if [[ -n "$port" ]]; then
  echo "registry: localhost:$port (in-cluster $name-registry:5000)"
else
  echo "registry: not running"
fi
