#!/usr/bin/env bash
#MISE description="Delete a k3d cluster and its registry"
#USAGE arg "[name]" env="CLUSTER_NAME" help="Cluster name (must start with <component>-)"
set -euo pipefail
# Succeeds when the cluster is already gone; k3d removes the registry made by
# --registry-create along with the cluster. Other failures surface.
name="$usage_name"
[[ "$name" == "$CUR8S_COMPONENT"-* ]] || { echo "❌ cluster name must start with $CUR8S_COMPONENT-" >&2; exit 1; }
k3d cluster delete "$name"
