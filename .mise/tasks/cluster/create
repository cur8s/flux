#!/usr/bin/env bash
#MISE description="Create a k3d cluster + its local OCI registry"
#USAGE arg "[name]" env="CLUSTER_NAME" help="Cluster name (must start with <component>-)"
set -euo pipefail
# Returns once the API server accepts requests and the registry answers.
# Each cluster gets its own local OCI registry (container <name>-registry,
# reached in-cluster as <name>-registry:5000) on a host port k3d picks, so
# multiple clusters coexist without port conflicts. Its context lands in the
# repo-local KUBECONFIG, never ~/.kube/config. k3d fails on an existing name.
name="$usage_name"
[[ "$name" == "$CUR8S_COMPONENT"-* ]] || { echo "❌ cluster name must start with $CUR8S_COMPONENT-" >&2; exit 1; }
k3d cluster create "$name" --config .mise/k3d-config.yaml --registry-create "$name-registry"
# k3d writes the standard local-registry-hosting ConfigMap last (only warning if
# that fails); reading it proves the API server accepts requests and yields the
# registry's host endpoint.
host="$(kubectl --context "k3d-$name" -n kube-public get configmap local-registry-hosting \
  -o jsonpath='{.data.localRegistryHosting\.v1}' | sed -n 's/^host: //p')"
[[ -n "$host" ]] || { echo "❌ no local-registry-hosting ConfigMap on $name" >&2; exit 1; }
# k3d starts the registry after the server and does not wait for it.
curl -sf --retry 30 --retry-delay 2 --retry-all-errors "http://$host/v2/" >/dev/null
echo "✅ cluster $name (context k3d-$name), registry $host (in-cluster $name-registry:5000)"
