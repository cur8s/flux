#!/usr/bin/env bash
#MISE description="Hand Flux its self-management config (OCIRepository + Kustomization)"
#USAGE arg "[name]" env="CLUSTER_NAME" help="Cluster name"
#USAGE arg "[tag]" default="dev" help="Artifact tag to track"
set -euo pipefail
# After this, bumping the artifact tag is how Flux upgrades itself.
name="$usage_name"
flux --context "k3d-$name" create source oci flux \
  --url "oci://$name-registry:5000/flux" --tag "$usage_tag" --insecure --interval 1m
kubectl --context "k3d-$name" apply -f oci/flux/sync.yaml
