#!/usr/bin/env bash
#MISE description="Check drift and run the end-to-end cluster verification"
set -euo pipefail
paths=(artifacts/rendered upstream)
ctx="$(.mise/cluster.sh context verify)"

# Refuse to start if a leftover verify cluster exists from an earlier failed run.
if .mise/cluster.sh status verify >/dev/null 2>&1; then
  echo "❌ verify cluster already exists ($ctx) — inspect it or run 'mise run verify:clean' first" >&2
  exit 1
fi

# Drift: the committed artifacts/rendered/ tree is the review surface, so a fresh fetch +
# render must leave it (and the fetched input) unchanged. Commit a
# re-render before running verification.
mise run upstream:fetch
mise run build:render
if [ -n "$(git status --porcelain -- "${paths[@]}")" ]; then
  git status --short -- "${paths[@]}"
  git --no-pager diff -- "${paths[@]}" | head -100
  echo "❌ fresh render differs from the committed tree — review and commit the re-render" >&2
  exit 1
fi
echo "✅ committed tree matches the render"

# End-to-end cluster verification: deleted on pass, kept on failure.
cleanup() {
  local rc=$?
  if [ $rc -eq 0 ]; then
    echo "✅ verification passed — deleting the verify cluster"
    .mise/cluster.sh delete verify || true
  else
    echo "❌ verification failed (rc=$rc) — verify cluster preserved ($ctx)"
    flux --context "$ctx" get all -A || true
    echo "  mise exec -- flux --context $ctx get all -A"
    echo "  mise exec -- kubectl --context $ctx -n flux-system get pods"
    echo "  mise run verify:clean   # when done"
  fi
}
trap cleanup EXIT
.mise/env.sh create verify e2e
flux --context "$ctx" get all -A
