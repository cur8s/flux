#!/usr/bin/env bash
#MISE description="Full ephemeral proof: build → cluster → bootstrap → push → deploy → verify"
#USAGE arg "[cluster]" help="Ephemeral cluster name (default: <component>-e2e)"
set -euo pipefail
# On success the cluster is deleted; on failure it is preserved for debugging.
cluster="${usage_cluster:-$CUR8S_COMPONENT-e2e}"

cleanup() {
  local rc=$?
  if [ $rc -eq 0 ]; then
    echo "✅ e2e passed — deleting cluster '$cluster'"
    mise run cluster:delete "$cluster" || true
  else
    echo "❌ e2e failed (rc=$rc) — cluster '$cluster' preserved"
    mise run flux:status "$cluster" || true
    echo "  mise run cluster:delete $cluster   # when done"
  fi
}
trap cleanup EXIT

mise run artifact:build
mise run cluster:create "$cluster"
mise run flux:bootstrap "$cluster"
mise run artifact:push --cluster "$cluster" --tag e2e
mise run artifact:deploy --cluster "$cluster" --tag e2e
mise run artifact:verify --cluster "$cluster"
mise run flux:status "$cluster"
