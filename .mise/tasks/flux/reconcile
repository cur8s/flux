#!/usr/bin/env bash
#MISE description="Reconcile this component's OCIRepository and Kustomization now"
#USAGE arg "[cluster]" default="dev" help="Cluster role" {
#USAGE   choices "dev" "test"
#USAGE }
set -euo pipefail
# Targets only this repo's component (the Kustomization named after it,
# with its source), never every Kustomization on the cluster.
flux --context "$(.mise/cluster.sh context "$usage_cluster")" -n flux-system \
  reconcile kustomization "$CUR8S_COMPONENT" --with-source
