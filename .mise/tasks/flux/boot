#!/usr/bin/env bash
#MISE description="Install Flux on a cluster from the locally rendered manifest"
#USAGE arg "[name]" env="CLUSTER_NAME" help="Cluster name"
set -euo pipefail
# Every component repo has this task; only the manifest source differs.
# Here Flux is the product, so it bootstraps from this repo's render.
# Server-side apply handles the large CRDs cleanly.
ctx="k3d-$usage_name"
kubectl --context "$ctx" apply --server-side -f artifacts/rendered/deploy/flux.yaml
kubectl --context "$ctx" -n flux-system wait deploy --all --for=condition=Available --timeout=3m
