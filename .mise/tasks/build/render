#!/usr/bin/env bash
#MISE description="Clean and render artifacts/rendered/ from local inputs"
#MISE depends=["build:clean"]
set -euo pipefail
# Offline render from captured upstream/ and authored src/; never fetches upstream.
upstream_manifest="upstream/flux.yaml"
if [[ ! -f "$upstream_manifest" ]]; then
  echo "❌ $upstream_manifest missing (run 'mise run upstream:fetch')" >&2
  exit 1
fi

echo "🔨 Rendering opinionated config → artifacts/rendered/ ..."
mkdir -p artifacts/rendered/deploy
kustomize build --load-restrictor=LoadRestrictionsNone \
  src/config/overlays/deploy > artifacts/rendered/deploy/flux.yaml
cp src/config/sync.yaml artifacts/rendered/sync.yaml

# The release descriptor: the artifact asserting its own identity, documented
# in docs/architecture/02-artifact-contents-and-metadata.md.
# Deliberately free of anything unknowable at render time (no git revision,
# no timestamp) so the committed tree regenerates byte-for-byte — source and
# revision are attached by .mise/cluster/push-artifact.sh as OCI annotations instead.
upstream_digest="sha256:$(openssl dgst -sha256 "$upstream_manifest" | awk '{print $NF}')"
cat > artifacts/rendered/cur8s.yaml <<DESCRIPTOR
# Cur8s release descriptor — the artifact asserts its own identity.
# Inert: read by humans and tooling, never applied to a cluster.
# Generated by 'mise run build:render'; do not edit.
schema: cur8s.io/release-descriptor/v1
component: ${CUR8S_COMPONENT}
version: ${CUR8S_VERSION}
upstream:
  project: ${UPSTREAM_PROJECT}
  version: ${UPSTREAM_TAG}
  digest: ${upstream_digest}
source: ${CUR8S_SOURCE}
docs: ${CUR8S_DOCS}
DESCRIPTOR

echo "   ✅ artifacts/rendered/deploy/flux.yaml"
echo "   ✅ artifacts/rendered/sync.yaml"
echo "   ✅ artifacts/rendered/cur8s.yaml"
