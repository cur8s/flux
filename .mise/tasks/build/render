#!/usr/bin/env bash
#MISE description="Clean, then render the captured inputs and opinionated overlay into the artifact tree (oci/flux/); never fetches"
#MISE depends=["build:clean"]
set -euo pipefail
in=src/flux/artifacts/fetched/manifests/flux.yaml
[ -f "$in" ] || { echo "❌ $in missing (run 'mise run upstream:fetch')" >&2; exit 1; }
echo "🔨 Rendering opinionated config → oci/flux/ ..."
digest="sha256:$(openssl dgst -sha256 "$in" | awk '{print $NF}')"
mkdir -p oci/flux/deploy
kustomize build --load-restrictor=LoadRestrictionsNone \
  src/flux/config/overlays/deploy > oci/flux/deploy/flux.yaml
cp src/flux/config/sync.yaml oci/flux/sync.yaml

# The release descriptor: the artifact asserting its own identity, documented
# in docs/architecture.md. Deliberately free of anything unknowable at render
# time (no git revision, no timestamp) so the committed tree
# regenerates byte-for-byte — source/revision are attached by
# artifact:push as standard OCI annotations instead. Identity facts come
# from mise.toml [env], the same source artifact:push annotates from.
cat > oci/flux/cur8s.yaml <<DESCRIPTOR
# Cur8s release descriptor — the artifact asserts its own identity.
# Inert: read by humans and tooling, never applied to a cluster.
# Generated by 'mise run build:render'; do not edit.
schema: cur8s.io/release-descriptor/v1
component: ${CUR8S_COMPONENT}
version: ${CUR8S_FLUX_VERSION}
upstream:
  project: ${CUR8S_UPSTREAM_PROJECT}
  version: ${FLUX_TAG}
  digest: ${digest}
source: ${CUR8S_SOURCE}
docs: ${CUR8S_DOCS}
DESCRIPTOR

echo "   ✅ oci/flux/deploy/flux.yaml"
echo "   ✅ oci/flux/sync.yaml"
echo "   ✅ oci/flux/cur8s.yaml"
