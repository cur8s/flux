#!/usr/bin/env bash
#MISE description="Point a cluster's Flux at the artifact in its local registry (OCIRepository + sync.yaml)"
#USAGE flag "--cluster <name>" env="CLUSTER_NAME" help="k3d cluster to deploy to"
#USAGE flag "--tag <tag>" default="dev" help="Artifact tag to track"
set -euo pipefail
# The artifact's sync.yaml sources from an OCIRepository named after the
# component; this task supplies it for the dev registry. After this,
# bumping the artifact tag is how the cluster upgrades the component.
c="$CUR8S_COMPONENT"
flux --context "k3d-$usage_cluster" create source oci "$c" \
  --url "oci://$usage_cluster-registry:5000/$c" --tag "$usage_tag" --insecure --interval 1m
kubectl --context "k3d-$usage_cluster" apply -f "oci/$c/sync.yaml"
