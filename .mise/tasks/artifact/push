#!/usr/bin/env bash
#MISE description="Push oci/<component>/ as an OCI artifact (default: the k3d cluster's local registry)"
#USAGE flag "--registry <url>" help="Remote registry, e.g. ghcr.io/cur8s (default: the cluster's local registry)"
#USAGE flag "--cluster <name>" env="CLUSTER_NAME" help="k3d cluster whose local registry receives the push"
#USAGE flag "--tag <tag>" default="dev" help="Artifact tag"
set -euo pipefail
# Every artifact that leaves this repo — dev push or release — goes
# through this task: the single insertion point for OCI metadata.
artifact="oci/$CUR8S_COMPONENT"
[ -d "$artifact" ] || { echo "❌ $artifact/ not built (run 'mise run artifact:build')" >&2; exit 1; }

registry="${usage_registry:-}"
if [ -z "$registry" ]; then
  registry="localhost:$(docker port "${usage_cluster}-registry" 5000 | head -1 | awk -F: '{print $NF}')"
  # The k3d-local registry is anonymous. A globally-configured docker
  # credential helper (e.g. Docker Desktop's "desktop" credsStore) will be
  # invoked for it anyway and can hang indefinitely on a localhost registry.
  # Point this push at a throwaway docker config with no credsStore so the
  # OCI client uses anonymous auth.
  DOCKER_CONFIG="$(mktemp -d)"; export DOCKER_CONFIG
  echo '{"auths":{}}' > "$DOCKER_CONFIG/config.json"
  trap 'rm -rf "$DOCKER_CONFIG"' EXIT
fi

url="oci://${registry}/${CUR8S_COMPONENT}:${usage_tag}"
echo "📦 $url"
# The same identity facts the descriptor asserts, readable from the
# registry without pulling the artifact; see docs/architecture.md. Source and
# revision ride flux push's standard OCI annotations — they are
# push-time facts, deliberately absent from the committed descriptor.
flux push artifact "$url" \
  --path="$artifact" \
  --source="$(git config --get remote.origin.url || echo unknown)" \
  --revision="$(git branch --show-current)@sha1:$(git rev-parse HEAD)" \
  --annotations="cur8s.io/component=${CUR8S_COMPONENT}" \
  --annotations="cur8s.io/version=${CUR8S_FLUX_VERSION}" \
  --annotations="cur8s.io/upstream=${CUR8S_UPSTREAM_PROJECT}" \
  --annotations="cur8s.io/upstream-version=${FLUX_TAG}" \
  --annotations="cur8s.io/docs=${CUR8S_DOCS}" \
  --timeout=5m
echo "✅ pushed $url"
