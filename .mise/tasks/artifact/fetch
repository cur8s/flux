#!/usr/bin/env bash
#MISE description="Generate the tracked Flux install manifest (offline, via flux CLI)"
set -euo pipefail
out=src/flux/artifacts/fetched/manifests/flux.yaml
echo "🔽 Generating Flux ${FLUX_TAG} install manifest (source/kustomize/notification)..."
mkdir -p "$(dirname "$out")"
flux install \
  --components=source-controller,kustomize-controller,notification-controller \
  --namespace=flux-system \
  --version="$FLUX_TAG" \
  --export > "$out"
echo "   ✅ $out"
