#!/usr/bin/env bash
#MISE description="Render, push to the dev cluster, and reconcile"
#MISE depends=["build:render"]
set -euo pipefail
# Requires a running dev cluster; pushes the rendered artifact, applies
# FLUX_SYNC_MANIFESTS, and triggers immediate reconciliation.
if ! .mise/cluster/cluster.sh host-registry dev >/dev/null 2>&1; then
  echo "❌ dev cluster is not running — run 'mise run dev:create' first" >&2
  exit 1
fi
.mise/cluster/push-artifact.sh local dev dev
kubectl --context "$(.mise/cluster/cluster.sh context dev)" apply -f "$FLUX_SYNC_MANIFESTS"
mise run dev:reconcile
