#!/usr/bin/env bash
#MISE description="Reconcile this component on the dev cluster"
set -euo pipefail
# Targets only this repo's component (the Kustomization named after it,
# with its source), never every Kustomization on the cluster.
flux --context "$(.mise/cluster/cluster.sh context dev)" -n flux-system \
  reconcile kustomization "$COMPONENT_NAME" --with-source
