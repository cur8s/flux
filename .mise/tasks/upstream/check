#!/usr/bin/env bash
#MISE description="Check for a newer upstream release"
set -euo pipefail
# Queries the GitHub Releases API to compare the latest release with UPSTREAM_TAG.
if [[ "$UPSTREAM_SOURCE" != https://github.com/*/* ]]; then
  echo "❌ upstream:check expects a GitHub URL in UPSTREAM_SOURCE (got $UPSTREAM_SOURCE)" >&2
  exit 1
fi
github_repo="${UPSTREAM_SOURCE#https://github.com/}"
github_repo="${github_repo%/}"
latest="$(curl -fsSL "https://api.github.com/repos/$github_repo/releases/latest" | jq -r .tag_name)"
echo "tracked: $UPSTREAM_TAG"
echo "latest:  $latest"
if [[ "$UPSTREAM_TAG" == "$latest" ]]; then
  echo "✅ up to date"
else
  cat <<'EOF'
⚠️  update available:
   1. Bump UPSTREAM_VERSION (and any matching tool pin) in mise.toml
   2. Run: mise lock --platform linux-x64,linux-arm64,macos-x64,macos-arm64
   3. Run: mise run upstream:fetch && mise run build:render && mise run verify:run
EOF
fi
