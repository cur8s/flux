#!/usr/bin/env bash
#MISE description="Fetch the pinned upstream manifest into upstream/"
set -euo pipefail
# Replaces the previously captured release; build:render consumes it.
out=upstream/flux.yaml
echo "🔽 Generating Flux ${FLUX_TAG} install manifest (source/kustomize/notification)..."
mkdir -p "$(dirname "$out")"
flux install \
  --components=source-controller,kustomize-controller,notification-controller \
  --namespace=flux-system \
  --version="$FLUX_TAG" \
  --export > "$out"
echo "   ✅ $out"
