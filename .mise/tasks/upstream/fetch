#!/usr/bin/env bash
#MISE description="Capture the pinned upstream Flux install manifest under src/flux/artifacts/ (offline, via flux CLI)"
set -euo pipefail
# Replaces the previously captured release; build:render consumes it.
dir=src/flux/artifacts/fetched
out="$dir/manifests/flux.yaml"
echo "🔽 Generating Flux ${FLUX_TAG} install manifest (source/kustomize/notification)..."
rm -rf "$dir"
mkdir -p "$(dirname "$out")"
flux install \
  --components=source-controller,kustomize-controller,notification-controller \
  --namespace=flux-system \
  --version="$FLUX_TAG" \
  --export > "$out"
echo "   ✅ $out"
